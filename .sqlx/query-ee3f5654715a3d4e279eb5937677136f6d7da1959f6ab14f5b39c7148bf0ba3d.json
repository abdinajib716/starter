  "query": "SELECT o.id, o.name, o.slug::text AS \"slug!\", o.is_default, o.is_active, o.max_users, o.created_at,\n                  (SELECT count(*) FROM users u WHERE u.org_id = o.id AND u.deleted_at IS NULL) AS \"users!\"\n           FROM organizations o ORDER BY o.is_default DESC, o.name",
