# Copy to .env for local development. Real environment variables override .env.
# Never commit .env. Secrets live only in .env / the server environment (§17).

# Postgres from docker-compose.yml (port 5440 on the host)
DATABASE_URL=postgres://starter:starter_dev_pw@127.0.0.1:5440/starter
# Used by `just test`: sqlx creates throwaway databases next to this one
TEST_DATABASE_URL=postgres://starter:starter_dev_pw@127.0.0.1:5440/starter_test

# Public origin of the app (scheme://host[:port], no path). Required in production.
# In dev it must be the dx serve address, because the dx proxy rewrites the Host header.
APP_URL=http://127.0.0.1:8080
# Header with the client IP set by your reverse proxy (production behind Caddy: x-forwarded-for)
# CLIENT_IP_HEADER=x-forwarded-for

APP_ENV=development              # development | production
APP_SECRET=change-me-to-32-random-bytes-minimum   # required (>= 32 bytes) in production
COOKIE_SECURE=false              # must be true in production
TENANCY_MODE=single              # single | multi (install-time, §18)
BACKUP_DIR=./data/backups
DB_MAX_CONNECTIONS=10

# First-run admin (created with must_change_pw = true) — used from M1
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!234

# Listen address: `dx serve` sets these in dev; set them in the container in prod.
# (Replaces the blueprint's SITE_ADDR — Dioxus reads IP/PORT.)
IP=0.0.0.0
PORT=8080

# ---- Secrets for optional modules (System Setting shows only "configured / missing") ----
# RESEND_API_KEY=            # email (§20), required to turn email on
# BACKUP_PUBLIC_KEY=         # age recipient for encrypted backups (§24.2)
# BACKUP_ENCRYPTION_KEY=     # 32-byte key for backup.encrypt_mode = symmetric
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET=
# GDRIVE_SERVICE_ACCOUNT_JSON= / GDRIVE_FOLDER_ID=
